@model IEnumerable<KurumsalWeb.Models.Model.Slider>

<div id="hero-carousel"
     class="carousel slide carousel-fade"
     data-bs-ride="carousel"
     data-bs-interval="5000">

    <div class="carousel-inner">

        @foreach (var item in Model)
        {
            <div class="carousel-item @(item == Model.First() ? "active" : "")">

               
                <div class="carousel-container">
                    <h2>@item.Baslik</h2>
                    <p>@item.Aciklama</p>
                    <a href="#about" class="btn-get-started">Read More</a>
                </div>

            </div>
        }

    </div>

    <a class="carousel-control-prev" href="#hero-carousel" role="button" data-bs-slide="prev">
        <span class="carousel-control-prev-icon bi bi-chevron-left"></span>
    </a>

    <a class="carousel-control-next" href="#hero-carousel" role="button" data-bs-slide="next">
        <span class="carousel-control-next-icon bi bi-chevron-right"></span>
    </a>

</div>
