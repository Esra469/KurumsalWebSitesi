@section scripts{
    <script>
$(function () {

    console.log("BlogDetay script çalıştı");

    var blogId = @Model.BlogId;

    $("#gonder").on("click", function () {

        console.log("butona basıldı");

        var adisoyadi = $("#adsoyad").val();
        var epostasi  = $("#eposta").val();
        var yorumunuz = $("#icerik").val();

        $.ajax({
            url: '@Url.Action("YorumYap", "Home")',
            type: 'POST',
            dataType: 'json',
            data: {
                adsoyad: adisoyadi,
                eposta: epostasi,
                icerik: yorumunuz,
                blogid: blogId
            },
            success: function (sonuc) {
                console.log("success:", sonuc);
                alert(sonuc.message || "Lütfen tüm alanları doldurun");
            },
            error: function (xhr) {
                console.log("error:", xhr.status, xhr.responseText);
                alert("Hata: " + xhr.status);
            }
        });
    });

});
    </script>
}
