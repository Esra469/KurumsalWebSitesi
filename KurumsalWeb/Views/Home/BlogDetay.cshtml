@model KurumsalWeb.Models.Model.Blog

@{
    ViewBag.Title = "BlogDetay";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title dark-background">
        <div class="container position-relative">
            <h1>Blog Detay</h1>
            <p>Blog Detaylarına Bu Sayfada Ulaşabilirsiniz.</p>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Ana Sayfa</a></li>
                    <li class="current">Blog Detay</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->

    <div class="container">
        <div class="row">

            <div class="col-lg-8">

                <!-- Blog Details Section -->
                <section id="blog-details" class="blog-details section">
                    <div class="container">

                        <article class="article">

                            <div class="post-img">
                                <img src="/Content/SiteLayout/assets/img/blog/blog-1.jpg" alt="" class="img-fluid">
                            </div>

                            <h2 class="title">Dolorum optio tempore voluptas dignissimos cumque fuga qui quibusdam quia</h2>

                            <div class="meta-top">
                                <ul>
                                    <li class="d-flex align-items-center"><i class="bi bi-person"></i> <a href="blog-details.html">John Doe</a></li>
                                    <li class="d-flex align-items-center"><i class="bi bi-clock"></i> <a href="blog-details.html"><time datetime="2020-01-01">Jan 1, 2022</time></a></li>
                                    <li class="d-flex align-items-center"><i class="bi bi-chat-dots"></i> <a href="blog-details.html">12 Comments</a></li>
                                </ul>
                            </div><!-- End meta top -->

                            <div class="content">
                                

                            </div><!-- End post content -->

                            <div class="meta-bottom">
                                <i class="bi bi-folder"></i>
                                <ul class="cats">
                                    <li><a href="#">Business</a></li>
                                </ul>

                                <i class="bi bi-tags"></i>
                                <ul class="tags">
                                    <li><a href="#">Creative</a></li>
                                    <li><a href="#">Tips</a></li>
                                    <li><a href="#">Marketing</a></li>
                                </ul>
                            </div><!-- End meta bottom -->

                        </article>

                    </div>
                </section><!-- /Blog Details Section -->

                <!-- Blog Comments Section -->
               
                <!-- Comment Form Section -->
                <section id="comment-form" class="comment-form section">
                    <div class="container">

                        <form action="">

                            <h4>Yorum yap</h4>
                           
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <input  type="text" id="adsoyad" class="form-control" placeholder="Adınız">
                                </div>
                                <div class="col-md-6 form-group">
                                    <input  type="email" id="eposta" class="form-control" placeholder="Email adresiniz">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col form-group">
                                    <input  type="text" id="icerik" class="form-control" placeholder="İçerik">
                                </div>
                            </div>  
                            <div class="row">   
                                <div class="col form-group">
                                    <textarea name="comment" class="form-control" placeholder="Yorumunuz"></textarea>
                                </div>
                            </div>

                            <div class="text-center">
                                <button id="gender" type="submit" class="btn btn-primary">Post Yorum</button>
                            </div>

                        </form>

                    </div>
                </section><!-- /Comment Form Section -->

            </div>

            <div class="col-lg-4 sidebar">

                <div class="widgets-container">

                    <!-- Blog Author Widget -->
                    <div class="blog-author-widget widget-item">

                        <div class="d-flex flex-column align-items-center">
                            <img src="/Content/SiteLayout/assets/img/blog/blog-author.jpg" class="rounded-circle flex-shrink-0" alt="">
                            <h4>Jane Smith</h4>
                            <div class="social-links">
                                <a href="https://x.com/#"><i class="bi bi-twitter-x"></i></a>
                                <a href="https://facebook.com/#"><i class="bi bi-facebook"></i></a>
                                <a href="https://instagram.com/#"><i class="biu bi-instagram"></i></a>
                                <a href="https://instagram.com/#"><i class="biu bi-linkedin"></i></a>
                            </div>

                            <p>
                                Itaque quidem optio quia voluptatibus dolorem dolor. Modi eum sed possimus accusantium. Quas repellat voluptatem officia numquam sint aspernatur voluptas. Esse et accusantium ut unde voluptas.
                            </p>

                        </div>
                    </div><!--/Blog Author Widget -->
                    <!-- Search Widget -->
                    <div class="search-widget widget-item">

                        <h3 class="widget-title">Search</h3>
                        <form action="">
                            <input type="text">
                            <button type="submit" title="Search"><i class="bi bi-search"></i></button>
                        </form>

                    </div><!--/Search Widget -->

                    <!-- Categories Widget -->
                    <div class="categories-widget widget-item">

                        <h3 class="widget-title">Categories</h3>
                        <ul class="mt-3">
                            <li><a href="#">General <span>(25)</span></a></li>
                            <li><a href="#">Lifestyle <span>(12)</span></a></li>
                            <li><a href="#">Travel <span>(5)</span></a></li>
                            <li><a href="#">Design <span>(22)</span></a></li>
                            <li><a href="#">Creative <span>(8)</span></a></li>
                            <li><a href="#">Educaion <span>(14)</span></a></li>
                        </ul>

                    </div><!--/Categories Widget -->


                    <!-- Recent Posts Widget -->
                    <div class="recent-posts-widget widget-item">

                        <h3 class="widget-title">Recent Posts</h3>

                        <div class="post-item">
                            <img src="/Content/SiteLayout/assets/img/blog/blog-recent-1.jpg" alt="" class="flex-shrink-0">
                            <div>
                                <h4><a href="blog-details.html">Nihil blanditiis at in nihil autem</a></h4>
                                <time datetime="2020-01-01">Jan 1, 2020</time>
                            </div>
                        </div><!-- End recent post item-->


                        <div class="post-item">
                            <img src="~/Content/SiteLayout/assets/img/blog/blog-recent-2.jpg" alt="" class="flex-shrink-0">
                            <div>
                                <h4><a href="blog-details.html">Nihil blanditiis at in nihil autem</a></h4>
                                <time datetime="2020-01-01">Jan 1, 2020</time>
                            </div>
                        </div>




                    </div><!--/Recent Posts Widget -->
                   

                </div>

            </div>

        </div>
    </div>

</main>



<!--#(diez) etiketi direkt yakalamak için önüne konur -->
<script type="text/javascript">
    $(document).ready(function () {
        $("#gender").click(function () {
            var adisoyadi = $("#adsoyad").val();
            var epostasi = $("#eposta").val();
            var yorumunuz = $("icerik").val();

            var blogId = '@(Model != null ? Model.BlogId : 0)';
            $.ajax({
                url: '/Home/YorumYap',
                type: 'POST',
                dataType: 'json',
                data: {
                    adisoyadi: adisoyadi,
                    eposta: epostasi,
                    icerik:yorumunuz,
                   
                },

                
                success: function (data) {
                    alert(adisoyadi +" - yorumunuz eklendi, kontrol edildikten sonra yayınlanacaktır.")
                }
            })
        });
    })



</script>
