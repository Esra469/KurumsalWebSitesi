@model KurumsalWeb.Models.Model.Blog

@{
    ViewBag.Title = "BlogDetay";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title dark-background">
        <div class="container position-relative">
            <h1>Blog Detay</h1>
            <p>Blog Detaylarına Bu Sayfada Ulaşabilirsiniz.</p>
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="index.html">Ana Sayfa</a></li>
                    <li class="current">Blog Detay</li>
                </ol>
            </nav>
        </div>
    </div><!-- End Page Title -->



    <div class="container">
        <div class="row">

            <div class="col-lg-8">

                <section id="blog-details" class="blog-details section">
                    <div class="container">

                        <article class="article">

                            <div class="post-img">
                                <img src="@Model.ResimURL" alt="@Model.Baslik" class="img-fluid w-100"
                                     style="max-height:450px; object-fit:cover;">
                            </div>

                            <h2 class="title">@Model.Baslik</h2>

                            <div class="meta-top">
                                <ul>
                                    <li class="d-flex align-items-center">
                                        <i class="bi bi-folder"></i>
                                        <a href="#">@Model.Kategori.KategoriAd</a>
                                    </li>

                                    <li class="d-flex align-items-center">
                                        <i class="bi bi-clock"></i>
                                        <time datetime="@DateTime.Now.ToString("yyyy-MM-dd")">@DateTime.Now.ToString("dd MMM yyyy")</time>
                                    </li>
                                </ul>
                            </div>

                            <div class="content">
                                @Html.Raw(Model.İcerik)
                            </div>

                        </article>

                    </div>
                </section>


                <section id="comment-form" class="comment-form section">
                    <div class="container">
                        <form>
                            <h4>Yorum yap</h4>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <input type="text" id="adsoyad" class="form-control" placeholder="Adınız">
                                </div>
                                <div class="col-md-6 form-group">
                                    <input type="email" id="eposta" class="form-control" placeholder="Email adresiniz">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col form-group">
                                    <textarea id="icerik" class="form-control" placeholder="Yorumunuz"></textarea>
                                </div>
                            </div>

                            <div class="text-center">
                                <button id="gonder" type="button" class="btn btn-primary">Post Yorum</button>
                            </div>
                        </form>
                    </div>
                </section>

            </div>

            <!-- SAĞ: Sidebar -->
            <div class="col-lg-4 sidebar">
                <div class="widgets-container">

                    <!-- Author widget -->
                    <div class="blog-author-widget widget-item">
                        <div class="d-flex flex-column align-items-center">
                            <img src="/Content/SiteLayout/assets/img/blog/blog-author.jpg"
                                 class="rounded-circle flex-shrink-0" alt="">
                            <h4>Maria Doe</h4>
                            <p>Yazar bilgisi buraya.</p>
                        </div>
                    </div>

                    <!-- Search -->
                    <div class="search-widget widget-item">
                        <h3 class="widget-title">Search</h3>
                        <form>
                            <input type="text">
                            <button type="submit" title="Search"><i class="bi bi-search"></i></button>
                        </form>
                    </div>

                    <!-- Categories -->
                    <div class="categories-widget widget-item">
                        <h3 class="widget-title">Categories</h3>
                        <ul class="mt-3">
                            <li><a href="#">@Model.Kategori.KategoriAd <span>(1)</span></a></li>
                            @* İstersen tüm kategorileri ViewBag ile burada listele *@
                        </ul>
                    </div>

                    <!-- Recent Posts -->
                    <div class="recent-posts-widget widget-item">
                        <h3 class="widget-title">Recent Posts</h3>

                        @* Bunu gerçek veriye bağlamak için ViewBag.RecentBlogs kullanabilirsin *@
                        <div class="post-item">
                            <img src="@Model.ResimURL" alt="" class="flex-shrink-0">
                            <div>
                                <h4><a href="#">@Model.Baslik</a></h4>
                                <time datetime="@DateTime.Now.ToString("yyyy-MM-dd")">@DateTime.Now.ToString("dd MMM yyyy")</time>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>



</main>

