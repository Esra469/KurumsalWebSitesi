@model KurumsalWeb.Models.Model.iletisim

<footer id="footer" class="footer dark-background">

    <div class="footer-newsletter">
    </div>

    <div class="container footer-top">
        <div class="row gy-4">

            <div class="col-lg-4 col-md-6 footer-about">
                <a href="index.html" class="d-flex align-items-center">
                    <span class="sitename">Moderna</span>
                </a>

                <div class="footer-contact pt-3">
                    @if (Model != null)
                    {
                        <p>@Model.Adres</p>
                        <p class="mt-3"><strong>Phone:</strong> <span>@Model.Telefon</span></p>
                        <p class="mt-3"><strong>Fax:</strong> <span>@Model.Fax</span></p>
                        <p class="mt-3"><strong>Whatsapp:</strong> <span>@Model.Whatsapp</span></p>

                        <div class="social-links d-flex mt-4">
                            <a href="@Model.Facebook"><i class="bi bi-facebook"></i></a>
                            <a href="@Model.Twitter"><i class="bi bi-twitter-x"></i></a>
                            <a href="@Model.Instagram"><i class="bi bi-instagram"></i></a>
                        </div>
                    }
                    else
                    {
                        <p>İletişim bilgileri yüklenemedi.</p>
                    }
                </div>
            </div>

            <div class="col-lg-2 col-md-3 footer-links">
                <h4>Hızlı Linkler</h4>
                <ul>
                    <li><i class="bi bi-chevron-right"></i> <a href="/Home/Index/">Ana Sayfa</a></li>
                    <li><i class="bi bi-chevron-right"></i> <a href="/Home/Hakkimizda/">Hakkımızda</a></li>
                    <li><i class="bi bi-chevron-right"></i> <a href="/Home/Hizmetlerimiz/">Hizmetler</a></li>
                    <li><i class="bi bi-chevron-right"></i> <a href="/Home/Iletisim/">İletişim</a></li>
                </ul>
            </div>

            <div class="col-lg-4 col-md-12">
                <h4>Son Yazılar</h4>
                @if (ViewBag.Blog != null)
                {
                    foreach (var item in ViewBag.Blog)
                    {
                        <p style="color:white; font-size:14px;">
                            <i class="bi bi-chevron-right"></i> @item.Baslik
                        </p>
                    }
                }
            </div>



        </div>
    </div>

    <div class="container copyright text-center mt-4">
        <p>@DateTime.Now.Year <span>Tüm haklar saklıdır</span></p>
        <div class="credits">
            Designed by <a href="https://bootstrapmade.com/"><strong class="px-1 sitename">Kurumsal Web</strong></a>
        </div>
    </div>

</footer>