@model IEnumerable<KurumsalWeb.Models.Model.Kategori>

<div class="categories">
    <ul class="list-unstyled">

       
        @foreach (var item in Model)
        {
            

            <li class="border-bottom py-2 text-start">

                <a href="/Home/KategoriBlog/@item.KategoriId" class="text-decoration-none text-secondary d-block hover-effect">
                    (@item.Blogs.Count())

                    <i class="bi bi-chevron-right me-2 text-primary" style="font-size: 0.8rem;"></i>

                    <span style="font-size: 16px; font-weight: 500;">@item.KategoriAd</span>
                </a>

            </li>
        }

    </ul>
</div>

<style>
    .hover-effect {
        transition: all 0.3s ease;
    }

        .hover-effect:hover {
            color: #eb5d1e !important; /* Moderna teması turuncu rengi */
            /* Sağa kayma efekti */
            padding-left: 10px; 
        }
</style>