@model IEnumerable<KurumsalWeb.Models.Model.Blog>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}



<script>
    $(document).ready(function () {
        $('#mytable').DataTable(
            {
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.3.6/i18n/tr.json',
                },
            }
        );
    });
</script>

<h2>Blog Kayıtları</h2>

<a class="btn btn-primary" href="/Blog/Create">Yeni Blog Ekle</a>
<table class="table table-striped" id="mytable">
    <thead>
        <tr>
            <th>#</th>
            <th>Başlık</th>
            <th>Kategori</th>
            <th>Resim URL</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BlogId</td>
                <td>@item.Baslik</td>
                <td>@item.Kategori.KategoriAd</td>
                <td><img src="@item.ResimURL" width="100" height="100" /></td>
                <td><a href="/Blog/Edit/@item.BlogId">Güncelle</a> | <a href="/Blog/Delete/@item.BlogId">Sil</a></td>
            </tr>
        }

    </tbody>
</table>