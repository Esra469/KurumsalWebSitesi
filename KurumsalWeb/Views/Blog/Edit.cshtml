@model KurumsalWeb.Models.Model.Blog

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Kategori Düzenle</h2>


<div class="card card-primary card-outline mb-4">
    <!--begin::Header-->
    <div class="card-header"><div class="card-title">Hizmet Ekle</div></div>
    <!--end::Header-->
    <!--begin::Form-->
    @*@<form asp-action="Create" asp-controller="Hizmet" method="post" action="/Blog/Create/" enctype="multipart/form-data">*@
    <!--begin::Body-->

    @using (Html.BeginForm("Edit", "Blog", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken();
        <div class="card-body">
            <div class="mb-3">
                <label for="cname" class="form-label">Başlık <span class="required">*</span></label>
                <input type="text"
                       class="form-control"
                       name="Baslik"
                       value="@Model.Baslik" />

            </div>
            <div class="mb-3">
                <label for="cname" class="control-label col-lg-2 ">Kategori<span class="required">*</span></label>
                <div class="col-lg-10">
                    @Html.DropDownList("KategoriId", null, new { @class = "form-control" })
                </div>
            </div>

            <div class="mb-3">
                <label for="cname" class="control-label col-lg-2 ">İçerik<span class="required">*</span></label>
                
                <textarea class="form-control" name="icerik">@Model.İcerik</textarea>
            </div>

            <div class="mb-3">

                <label class="control-label col-lg-2" for="curl">Önceki Resim</label>
                <img  src="@Model.ResimURL" width="150" height="100"/>
            </div>
            <div class="mb-3">

                <label class="control-label col-lg-2" for="curl">Resim</label>
                <input type="file" class="form-control" name="ResimURL" accept=".jpg,.png,.jpeg" />
            </div>

        </div>
        <!--end::Body-->
        <!--begin::Footer-->
        <div class="form-group">
            <div class="col-lg-offset-2 col-lg-10">
                <button type="submit" class="btn btn-primary">Güncelle</button>
                <button type="button" class="btn btn-default"><a href="/Blog/Index">İptal</a></button>
            </div>
        </div>
        <!--end::Footer-->
        <!--</form>-->
        <!--end::Form-->
    }
    </div>