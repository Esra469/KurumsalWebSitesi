@model KurumsalWeb.Models.Model.Hizmet
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Hizmet Edit</h2>


<div class="card card-primary card-outline mb-4">
    <!--begin::Header-->
    <div class="card-header"><div class="card-title">Hizmet Ekle</div></div>
    <!--end::Header-->
    <!--begin::Form-->
    <form asp-action="Create" asp-controller="Hizmet" method="post" action="/Hizmet/Edit/@Model.HizmetId" enctype="multipart/form-data">
        <!--begin::Body-->
        <div class="card-body">
            <div class="mb-3">
                <label for="cname" class="form-label">Başlık <span class="required">*</span></label>
                <input type="text"
                       class="form-control"
                       name="Baslik"
                       required
                       value="@Model.Baslik" />

            </div>
            <div class="mb-3">
                <textarea name="Aciklama" required>@Model.Aciklama</textarea>
            </div>

            <div class="mb-3">

                <label class="control-label col-lg-2" for="curl">Önceki Resim</label>
                <img src="@Model.ResimURL" height="150" width="150">
            </div>
            <div class="mb-3">

                <label class="control-label col-lg-2" for="curl">Resim URL</label>
                <input type="file" class="form-control" name="ResimURL" accept=".jpg,.png,.jpeg" />
            </div>

        </div>
        <!--end::Body-->
        <!--begin::Footer-->
        <div class="form-group">
            <div class="col-lg-offset-2 col-lg-10">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <button type="button" class="btn btn-default"><a href="/Hizmet/Index">İptal</a></button>
            </div>
        </div>
        <!--end::Footer-->
    </form>
    <!--end::Form-->
</div>
