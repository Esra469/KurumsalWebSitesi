
@model IEnumerable<KurumsalWeb.Models.Model.Hizmet> 
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Hizmetler</h2>

<a clas="btn btn-default" href="/Hizmet/Create">Yeni Ekle</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th style="width: 10px">#</th>
            <th>Baslık</th>
            <th>Açıklama</th>
            <th>Resim URL</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
          @foreach (var item in Model)
          {
              <tr>
                  <td>@item.HizmetId</td>
                  <td>@item.Baslik</td>
                  <td>@item.Aciklama </td>
                  <td><img width="100" height="100" src=" @item.ResimURL" /></td>
              </tr> 
          }
    </tbody>

</table>